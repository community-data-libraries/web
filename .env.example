# Environment Variables Example
# Copy this file to .env and fill in your actual values

# API Configuration (for future use)
# API_KEY=your_api_key_here
# API_BASE_URL=https://api.example.com

# Site Configuration
# PUBLIC_SITE_URL=https://community-data-libraries.github.io/web

# Database Configuration (for future use)
# DATABASE_URL=your_database_connection_string

# Authentication (for future use)
# AUTH_SECRET=your_auth_secret_here
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret

# Analytics (for future use)
# PUBLIC_ANALYTICS_ID=your_analytics_id

# Feature Flags
# ENABLE_COMMUNITY_SUBMISSIONS=true
# ENABLE_SEARCH=true

# Community Library Instantiation Automation
# GitHub token with repo + workflow permissions in CDL org/account
# CDL_GITHUB_TOKEN=ghp_xxxxx

# Owner where community repos will be created
# CDL_GITHUB_OWNER=community-data-libraries

# Template repository used for new community library repos (owner/repo)
# CDL_TEMPLATE_REPO=community-data-libraries/community-library-template

# Optional: programmatically create Netlify site from generated repo
# CDL_NETLIFY_CREATE_SITE=false
# CDL_NETLIFY_AUTH_TOKEN=nfp_xxxxx
# CDL_NETLIFY_TEAM_ID=community-data-libraries
# CDL_NETLIFY_SITE_NAME_PREFIX=cdl-community
