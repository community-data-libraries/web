---
import Layout from '@layouts/Layout.astro';
---

<Layout
  title="Lesson Plans"
  description="Classroom-ready lesson plans and teaching resources using community data."
>
  <section class="page-shell">
    <header class="page-header">
      <p class="eyebrow">For Educators</p>
      <h1>Lesson Plans</h1>
      <p class="intro">
        Curated, classroom-ready materials for teachers using community data. Lessons are designed around real local datasets and require no prior data science experience.
      </p>
    </header>

    <div class="coming-soon">
      <div class="cs-icon" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      </div>
      <h2>Coming next summer</h2>
      <p>
        Lesson plans are in development and will be published here when ready. Each lesson will be tied to specific datasets in the catalog, with learning objectives, discussion prompts, and data activity guides.
      </p>
    </div>
  </section>

  <style>
    .page-shell {
      display: grid;
      gap: var(--space-12);
      max-width: 780px;
    }

    .page-header {
      display: grid;
      gap: var(--space-3);
    }

    .eyebrow {
      margin: 0;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: var(--font-size-xs);
      font-weight: 700;
      color: var(--color-secondary);
    }

    .page-header h1 {
      margin: 0;
      font-size: clamp(2.25rem, 4vw, 3.5rem);
    }

    .intro {
      margin: 0;
      max-width: 62ch;
      color: var(--color-text-muted);
      font-size: var(--font-size-lg);
      line-height: var(--line-height-relaxed);
    }

    .coming-soon {
      display: grid;
      gap: var(--space-4);
      padding: var(--space-10) var(--space-8);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      background: var(--color-surface);
      justify-items: start;
    }

    .cs-icon {
      width: 3.5rem;
      height: 3.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-lg);
      background: var(--color-primary-glow);
      color: var(--color-primary);
    }

    .coming-soon h2 {
      margin: 0;
      font-size: var(--font-size-2xl);
    }

    .coming-soon p {
      margin: 0;
      max-width: 56ch;
      color: var(--color-text-muted);
      line-height: var(--line-height-relaxed);
    }
  </style>
</Layout>
