---
import CommunityLayout from '@layouts/CommunityLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { libraryHref } from '@lib/paths';
import { AUDIENCE_ROLES, communityDisplay } from '@lib/data/communityFilter';
import { stateCountyOutline } from '@lib/data/countyOutline';
import { countyBurst } from '@lib/data/countyBurst';
import { pointillistScene } from '@lib/data/pointillistScene';

export async function getStaticPaths() {
  const communities = await getCollection('communities');
  return communities.map((community) => ({
    params: { slug: community.data.slug },
    props: { community },
  }));
}

interface Props {
  community: CollectionEntry<'communities'>;
}

const { community } = Astro.props;
const data = community.data;
const { libraryTitle, welcomeHeading, placeName } = communityDisplay(data);
const catalogHref = libraryHref(data.slug, '/catalog/');
const location = [data.county, data.state_code].filter(Boolean).join(', ');

// e.g. "Knoxville Community Data Library"; falls back to the entry's `name`
// when it has no place_name (see communityDisplay).
const pageHeading = libraryTitle;
const footerTitle = libraryTitle;

// Tagline under the heading, the same wording for every library, e.g.
// "Curated open data resources for Knox County, Tennessee." Falls back to the
// place name if the county or state is missing. (The entry's own description is
// still used for the page's meta description.)
const taglinePlace =
  [data.county, data.state_name ?? data.state_code].every(Boolean)
    ? `${data.county}, ${data.state_name ?? data.state_code}`
    : placeName;
const tagline = `Curated open data resources for ${taglinePlace}.`;

// State + county for the header graphic: the whole state, with this county
// filled in on it. Resolved at build time from the TIGER topology in
// public/geo/boundaries/ by the entry's 5-digit county_fips (its first two
// digits are the state), so the 800 KB file never reaches the browser. Null
// when the code is missing/unknown, in which case the graphic is skipped and
// the header text fills the row.
// Straight-sided states (e.g. Tennessee) get a decorative tilt so they rise to
// the right; states that already lean (e.g. California) keep their real angle.
const shapes = stateCountyOutline(data.county_fips, {
  tilt: { target: 10, max: 12 }, // degrees: lean to aim for / most we'll rotate
});
const stateLabel = data.state_name ?? data.state_code;
const mapLabel = [data.county, stateLabel].every(Boolean)
  ? `Map of ${stateLabel} with ${data.county} highlighted`
  : `Map of ${stateLabel ?? 'the state'}`;

// Dotted backdrop: a few rows of dots tracing the state's outline, then rays
// of dots bursting outward from the outermost row. Built at build time from
// the outline's points (see countyBurst), seeded by the slug so each library's
// pattern is stable between builds but different from the next library's.
// Colours repeat in the list to weight them (teal/green most common).
const DOT_COLORS = [
  '#0B5075', // deep blue
  '#2BA58F',
  '#2BA58F', // teal
  '#3BAE7C',
  '#3BAE7C', // green
  '#7CC15D', // leaf green
  '#A3CE7A', // pale green
  '#8FD3D6', // light blue
  '#F5B942', // gold
];
const ART_W = 420; // frame viewBox width
const ART_H = 315; // frame viewBox height (4:3, matches the frame's aspect-ratio)

// Decorative initial: first letter of the county name, capitalised (e.g. "K"
// for Knox County), drawn in navy grosgrain to match the footer emblem's circle
// (and the navy version of the nav ribbon). Washington, DC is its own case: its
// one "county" is the whole district, so it always reads "DC" and may sit on
// top of the county. Skipped if there's no county name.
const isDC = data.state_code === 'DC';
const countyInitial = isDC
  ? 'DC'
  : ((data.county ?? '').match(/\p{L}/u)?.[0]?.toLocaleUpperCase() ?? '');

// Placement: countyBurst picks the spot and size for the letter so it NEVER
// covers the county, stays inside the frame, and otherwise sits as large as
// possible on the state, near the middle (see placeLetter).
const burst = shapes
  ? countyBurst(shapes.state, {
      width: ART_W,
      height: ART_H,
      seed: String(data.slug),
      colors: DOT_COLORS,
      countyScale: 0.72, // share of the frame the state fills
      avoid: shapes.county.rings, // the letter must never cover the county
      letter: countyInitial
        ? {
            text: countyInitial,
            coverCounty: isDC,
            maxSize: ART_H * 0.62,
            minSize: ART_H * 0.2,
          }
        : undefined,
      rows: 2, // outline rows hugging the state
      rays: false, // rows only; the pointillist scene fills the background
      rowGap: 9, // distance between outline rows
      spacing: 9, // distance between dots along a row or ray
      rayEvery: 2, // a ray starts at every 2nd dot of the outer row
      rayLength: [26, 60], // short / long ray lengths (alternating)
    })
  : null;

// Very light pointillist landscape (sky, grass, sun, cloud, tree) in a
// splotch-shaped patch behind the state; see pointillistScene.
const sceneDots = burst
  ? pointillistScene({
      width: ART_W,
      height: ART_H,
      seed: String(data.slug),
      avoid: burst.rings,
      letterBox: burst.letter?.box,
    })
  : [];


// Card titles. Written out here (rather than built from AUDIENCE_LABELS) so the
// cards can say "Community Catalog" while the shared label elsewhere on the
// site stays "Community Member".
const roleTitles = {
  teacher: 'Teacher Catalog',
  student: 'Student Catalog',
  community: 'Community Catalog',
} as const;

const roleDescriptions = {
  teacher:
    'View all datasets in our catalog relevant to your community, each tagged with K-12 statistics and data science topics to make lesson planning easier.',
  student:
    'View all datasets in our catalog relevant to your community, screened for topical appropriateness for a K-12 student audience.',
  community: 'View all datasets in our catalog relevant to your community.',
} as const;
---

<CommunityLayout
  title="Home"
  description={data.description ??
    `${libraryTitle}: local data for teachers, students, and community members.`}
  communityName={libraryTitle}
  communityLocation={location || undefined}
  communitySlug={data.slug}
  page="home"
  footerTitle={footerTitle}
>
  <section class="landing">
    <!-- Hero: the state with its county filled in, on a dotted burst (left),
         with the left-aligned title and intro to its right. Stacks
         on narrow screens. -->
    <div class="hero">
      {
        shapes && burst && (
          <div class="county-band">
            <div class="county-art-frame">
              <svg class="county-art" viewBox={`0 0 ${ART_W} ${ART_H}`} role="img" aria-label={mapLabel}>
                <defs>
                  <filter id="county-shadow" x="-30%" y="-30%" width="160%" height="160%">
                    <feDropShadow dx="2" dy="3" stdDeviation="2" flood-color="#06322c" flood-opacity="0.35" />
                  </filter>
                </defs>
                <g class="scene-dots" aria-hidden="true">
                  {sceneDots.map((dot) => (
                    <circle cx={dot.cx} cy={dot.cy} r={dot.r} fill={dot.fill} />
                  ))}
                </g>
                <g aria-hidden="true">
                  {burst.dots.map((dot) => (
                    <circle cx={dot.cx} cy={dot.cy} r={dot.r} fill={dot.fill} />
                  ))}
                </g>
                <g transform={burst.transform}>
                  <path class="state-shape" d={shapes.state.d} fill-rule="evenodd" vector-effect="non-scaling-stroke" />
                  <g filter="url(#county-shadow)">
                    {/* Gold halo: the county drawn again with a wide stroke underneath,
                        so a gold outline traces the county's own shape. */}
                    <path class="county-halo" d={shapes.county.d} vector-effect="non-scaling-stroke" />
                    <path class="county-shape" d={shapes.county.d} fill-rule="evenodd" vector-effect="non-scaling-stroke" />
                  </g>
                </g>
                {burst.letter && (
                  <g aria-hidden="true">
                    {/* Navy grosgrain: horizontal ribs (highlight, body, groove), the
                        same stops as .footer-mark in CommunityLayout. */}
                    <pattern id="county-initial-grosgrain" patternUnits="userSpaceOnUse" width="4" height="3.5">
                      <rect width="4" height="1" fill="#3D5A80" />
                      <rect y="1" width="4" height="1.5" fill="#31496A" />
                      <rect y="2.5" width="4" height="1" fill="#22374F" />
                    </pattern>
                    <text
                      class="county-initial"
                      x={burst.letter.x}
                      y={burst.letter.y}
                      font-size={burst.letter.size}
                      text-anchor="middle"
                      fill="url(#county-initial-grosgrain)"
                      filter="url(#county-shadow)"
                    >{countyInitial}</text>
                  </g>
                )}
              </svg>
            </div>
          </div>
        )
      }

      <header class="landing-header">
        <h1>{pageHeading}</h1>
        <p class="intro">{tagline}</p>
      </header>
    </div>

    <!-- Three equal-width cards (one per audience), spaced apart and raised with
         a drop shadow so they read as big, pressable entry points. They're
         links, not buttons, since each one navigates to the catalog. -->
    <section class="roles" aria-label="How will you use the library?">
      {
        AUDIENCE_ROLES.map((role) => (
          <a
            href={`${catalogHref}?audience=${role}`}
            class={`role-panel role-${role}`}
            data-audience={role}
          >
            <span class="role-inner">
              <span class="role-name">{roleTitles[role]}</span>
              <span class="role-desc">{roleDescriptions[role]}</span>
              <span class="role-arrow" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </span>
            </span>
          </a>
        ))
      }
    </section>
  </section>

  <script>
    import { saveAudience } from '../../../lib/client/audience';
    import { normalizeAudience } from '../../../lib/data/communityFilter';

    // The link already carries ?audience=; saving here also covers the case
    // where the visitor later returns to the catalog through the nav.
    document.querySelectorAll<HTMLAnchorElement>('.role-panel[data-audience]').forEach((panel) => {
      panel.addEventListener('click', () => {
        const role = normalizeAudience(panel.dataset.audience);
        if (role) {
          saveAudience(role);
          document.dispatchEvent(
            new CustomEvent('cdl:audience-change', { detail: { audience: role } })
          );
        }
      });
    });
  </script>

  <style>
    .landing {
      display: grid;
      gap: var(--space-12);
    }

    /* ── Hero: graphic on the left, text on the right ──
       Flex-wrap means it stacks automatically on narrow screens. */
    .hero {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-8);
      padding-top: var(--space-8);
    }

    .county-band {
      position: relative;
      flex: 0 0 auto;
      width: min(100%, 420px);
    }

    .county-art-frame {
      width: min(100%, 420px);
      aspect-ratio: 4 / 3;
    }

    /* One SVG holds both the dots and the county, so they share coordinates. */
    .county-art {
      display: block;
      width: 100%;
      height: 100%;
    }

    /* Background landscape: kept very light so it reads as texture. */
    .scene-dots {
      opacity: 0.6;
    }

    /* State in a pale teal tint; its county filled in the brand teal. */
    .state-shape {
      fill: #e4efee;
      stroke: #107366;
      stroke-width: 1.5;
      stroke-linejoin: round;
    }

    /* Half of this stroke sits outside the county, so a hairline shows. White,
       like the initial's edge, so the county reads as a cut-out on the state. */
    .county-halo {
      fill: none;
      stroke: #ffffff;
      stroke-width: 2.5;
      stroke-linejoin: round;
    }

    .county-shape {
      fill: #107366;
      stroke: #0b5a50;
      stroke-width: 1;
      stroke-linejoin: round;
    }

    /* Large navy-grosgrain initial (fill is the SVG pattern). The pale blue
       edge echoes the footer emblem circle's border; the stroke is painted under
       the fill, so only its outer half shows. */
    .county-initial {
      font-family: var(--font-display);
      font-weight: 800;
      stroke: #afe5f3;
      stroke-width: 3;
      stroke-linejoin: round;
      paint-order: stroke;
    }

    .landing-header {
      display: grid;
      justify-items: start;
      gap: var(--space-4);
      flex: 1 1 20rem;
      max-width: 70ch;
      margin: 0;
      text-align: left;
    }

    h1 {
      margin: 0;
      font-size: clamp(2.25rem, 5vw, 3.75rem);
      line-height: 1.05;
      text-wrap: balance;
    }

    .intro {
      margin: 0;
      font-size: var(--font-size-lg);
      color: var(--color-text-muted);
      line-height: var(--line-height-relaxed);
      text-wrap: pretty;
    }

    /* ── Audience cards ───────────────────────────
       A little wider than <main>'s 1200px column: centred and up to 1440px
       across (the full window on smaller screens), keeping a gutter at the
       sides, with three equal columns and whitespace between. */
    .roles {
      width: min(100vw, 1440px);
      margin-left: calc(50% - min(50vw, 720px));
      padding-inline: var(--space-6);
      box-sizing: border-box;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-6);
      padding-bottom: var(--space-8);
    }

    .role-panel {
      /* --bg: section tint; --ink: darker shade used for text and the arrow at rest */
      /* Each card spans three rows of the cards' grid and shares them (subgrid):
         title, description, arrow. A row is as tall as the tallest card's
         content in it, so titles, descriptions and arrows line up across all
         three cards at every width, and cards grow to fit their text instead of
         overflowing. The vertical padding scales with the window for presence. */
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
      row-gap: var(--space-4);
      justify-items: center;
      padding: clamp(var(--space-8), 5vw, 4.5rem) var(--space-8);
      text-align: center;
      background: var(--bg);
      color: var(--ink);
      border-radius: 0;
      box-shadow:
        0 2px 4px rgba(15, 23, 42, 0.06),
        0 12px 28px -6px rgba(15, 23, 42, 0.2);
      text-decoration: none;
      transition:
        background-color 0.2s ease,
        color 0.2s ease,
        box-shadow 0.2s ease,
        transform 0.2s ease;
    }

    .role-teacher {
      --bg: #e1f2f5;
      --ink: #426f78;
    }

    .role-student {
      --bg: #e5f1df;
      --ink: #56714d; /* darkened from #66865b for WCAG AA text contrast (4.65:1, 5.43:1 on hover) */
    }

    .role-community {
      --bg: #e4efee;
      --ink: #496f6b;
    }

    /* Let the title, description and arrow sit directly in the card's grid. */
    .role-inner {
      display: contents;
    }

    .role-name {
      font-family: var(--font-display);
      font-size: clamp(1.5rem, 2.4vw, 2.25rem);
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
      color: inherit;
    }

    .role-desc {
      align-self: start;
      max-width: 40ch;
      font-size: var(--font-size-base);
      line-height: 1.4;
      color: inherit;
    }

    /* Circular arrow button: filled with the current text colour, the arrow itself
       drawn in whatever the section background currently is. */
    .role-arrow {
      display: grid;
      place-items: center;
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: currentColor;
      color: inherit;
      transition:
        background-color 0.2s ease,
        color 0.2s ease;
    }

    .role-arrow svg {
      color: var(--bg);
      transition: color 0.2s ease;
    }

    /* Hover: the whole band flips to the darker shade, text and arrow disc go white,
       and the arrow glyph takes the (now dark) background colour. */
    /* …and the card lifts a little, its shadow deepening; pressing it settles it
       back down, like a big physical button. */
    .role-panel:hover,
    .role-panel:focus-visible {
      background: var(--ink);
      color: #ffffff;
      text-decoration: none;
      transform: translateY(-3px);
      box-shadow:
        0 4px 8px rgba(15, 23, 42, 0.08),
        0 20px 40px -8px rgba(15, 23, 42, 0.28);
    }

    .role-panel:active {
      transform: translateY(0);
      box-shadow:
        0 1px 2px rgba(15, 23, 42, 0.08),
        0 6px 14px -4px rgba(15, 23, 42, 0.2);
    }

    .role-panel:hover .role-arrow svg,
    .role-panel:focus-visible .role-arrow svg {
      color: var(--ink);
    }

    @media (max-width: 900px) {
      .roles {
        grid-template-columns: 1fr;
      }
      .role-panel {
        padding-block: var(--space-12);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .role-panel:hover,
      .role-panel:focus-visible,
      .role-panel:active {
        transform: none;
      }
      .role-panel,
      .role-arrow,
      .role-arrow svg {
        transition: none;
      }
    }
  </style>
</CommunityLayout>