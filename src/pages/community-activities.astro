---
import Layout from '@layouts/Layout.astro';
---

<Layout
  title="Community Activities"
  description="Workshop guides and activity materials for community data sessions."
>
  <section class="page-shell">
    <header class="page-header">
      <p class="eyebrow">For Communities</p>
      <h1>Community Activities</h1>
      <p class="intro">
        Workshop guides and facilitated activity materials for community groups, libraries, and civic organizations exploring local data together.
      </p>
    </header>

    <div class="coming-soon">
      <div class="cs-icon" aria-hidden="true">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <h2>Coming in two summers</h2>
      <p>
        Community activity guides are planned for a later release. Materials will include facilitation guides for public workshops, data walk activities, and community data storytelling sessions — all designed to be run without technical expertise.
      </p>
    </div>
  </section>

  <style>
    .page-shell {
      display: grid;
      gap: var(--space-12);
      max-width: 780px;
    }

    .page-header {
      display: grid;
      gap: var(--space-3);
    }

    .eyebrow {
      margin: 0;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-size: var(--font-size-xs);
      font-weight: 700;
      color: var(--color-secondary);
    }

    .page-header h1 {
      margin: 0;
      font-size: clamp(2.25rem, 4vw, 3.5rem);
    }

    .intro {
      margin: 0;
      max-width: 62ch;
      color: var(--color-text-muted);
      font-size: var(--font-size-lg);
      line-height: var(--line-height-relaxed);
    }

    .coming-soon {
      display: grid;
      gap: var(--space-4);
      padding: var(--space-10) var(--space-8);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      background: var(--color-surface);
      justify-items: start;
    }

    .cs-icon {
      width: 3.5rem;
      height: 3.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: var(--radius-lg);
      background: var(--color-primary-glow);
      color: var(--color-primary);
    }

    .coming-soon h2 {
      margin: 0;
      font-size: var(--font-size-2xl);
    }

    .coming-soon p {
      margin: 0;
      max-width: 56ch;
      color: var(--color-text-muted);
      line-height: var(--line-height-relaxed);
    }
  </style>
</Layout>
